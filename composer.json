{
    "name": "ismailnakkar/laravel-logging",
    "description": "Throttle reported exceptions and log lines, add request context to log lines, and redact secrets from logs and error trackers in Laravel.",
    "keywords": [
        "laravel",
        "logging",
        "exceptions",
        "throttle",
        "rate-limit",
        "redaction",
        "pulse",
        "sentry"
    ],
    "homepage": "https://github.com/ismailnakkar/laravel-logging",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Ismail Nakkar",
            "email": "juge.steam@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/ismailnakkar/laravel-logging/issues"
    },
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.21 || ^13.0",
        "monolog/monolog": "^3.0",
        "psr/log": "^1.0 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.18",
        "laravel/pulse": "^1.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "sentry/sentry-laravel": "^4.13"
    },
    "suggest": {
        "laravel/pulse": "Keeps an unthrottled exception rate signal alongside the throttled reports.",
        "sentry/sentry-laravel": "Redacts Sentry events and transactions by the same rules as log lines (4.x)."
    },
    "autoload": {
        "psr-4": {
            "Logging\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Logging\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "lint": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "check": [
            "vendor/bin/pint --test",
            "@analyse",
            "vendor/bin/phpunit"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Logging\\LoggingServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
